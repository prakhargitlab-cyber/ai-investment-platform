AIP_ENVIRONMENT=PRD
AIP_POSTGRES_HOST=<azure-postgresql-host>
AIP_REDIS_HOST=<azure-redis-host>
AIP_KAFKA_BOOTSTRAP_SERVERS=<managed-or-self-hosted-kafka-bootstrap>
AIP_LLM_PROVIDER=<configured-provider>
AIP_RESEARCH_LIVE_ENABLED=false
AIP_RESEARCH_DEMO_ENABLED=false

# Broker credentials and tokens must come from secure runtime configuration.
IBKR_ENABLED=false
IBKR_BASE_URL=
IBKR_CLIENT_ID=
IBKR_CALLBACK_URL=
IBKR_AUTH_METHOD=
IBKR_OFFICIAL_DOCUMENTATION_VERIFIED=false

ICICI_DIRECT_ENABLED=false
ICICI_DIRECT_BASE_URL=
ICICI_DIRECT_CLIENT_ID=
ICICI_DIRECT_CALLBACK_URL=
ICICI_DIRECT_AUTH_METHOD=
ICICI_DIRECT_OFFICIAL_DOCUMENTATION_VERIFIED=false

MARKET_DATA_DEMO_MODE=false
RESEARCH_ENGINE_BASE_URL=http://research-engine
# Store real values in Azure Key Vault / Kubernetes secrets, not in this file.
