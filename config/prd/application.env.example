AIP_ENVIRONMENT=AZURE
SPRING_PROFILES_ACTIVE=AZURE
AIP_POSTGRES_HOST=<azure-postgresql-host>
AIP_POSTGRES_PORT=5432
AIP_POSTGRES_SSL_MODE=verify-full
DB_SSL_MODE=verify-full
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SOCKET_TIMEOUT_SECONDS=30
DB_POOL_MAXIMUM_SIZE=6
DB_POOL_MINIMUM_IDLE=1
AIP_REDIS_HOST=<azure-redis-host>
AIP_REDIS_PORT=6380
AIP_REDIS_TLS_ENABLED=true
SPRING_DATA_REDIS_SSL_ENABLED=true
AIP_KAFKA_BOOTSTRAP_SERVERS=<managed-or-self-hosted-kafka-bootstrap>
AIP_KAFKA_SECURITY_PROTOCOL=SASL_SSL
AIP_KAFKA_SASL_MECHANISM=<provider-supported-mechanism>
AIP_KAFKA_CONSUMER_GROUP_PREFIX=<environment-specific-prefix>
# Kafka/Redis/DB credentials are intentionally omitted. Inject them from Key Vault-backed Kubernetes Secrets.
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector-host>:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=AZURE,cloud.provider=azure,cloud.platform=azure_aks
GATEWAY_HTTP_CONNECT_TIMEOUT=3s
GATEWAY_HTTP_READ_TIMEOUT=30s
AIP_FEATURE_MCP_ENABLED=true
AIP_MCP_TRANSPORT=streamable-http
AIP_MCP_HOST=0.0.0.0
AIP_MCP_PORT=8000
AIP_MCP_HTTP_PATH=/mcp
AIP_MCP_ALLOWED_HOSTS=mcp-gateway,mcp-gateway:*,mcp-gateway.<namespace>.svc,mcp-gateway.<namespace>.svc:*
AIP_MCP_RESEARCH_BASE_URL=http://research-engine
AIP_MCP_SERVICE_IDENTITY=mcp-gateway
AIP_MCP_AUTHENTICATION_TYPE=WORKLOAD_IDENTITY
AIP_MCP_SCOPES=mcp:read
AIP_MCP_INVOCATION_TIMEOUT_SECONDS=10
AIP_MCP_HTTP_CONNECT_TIMEOUT_SECONDS=3
AIP_MCP_HTTP_READ_TIMEOUT_SECONDS=8
AIP_MCP_EXTERNAL_PROVIDERS_ENABLED=false
AIP_MCP_EXTERNAL_CALLER_IDENTITIES=research-engine
AIP_MCP_YAHOO_ENABLED=false
AIP_MCP_YAHOO_TRANSPORT=streamable-http
AIP_MCP_YAHOO_ENDPOINT=http://yahoo-finance-mcp/mcp
AIP_MCP_YAHOO_AUTH_TYPE=NONE
AIP_MCP_YAHOO_CAPABILITIES_JSON=[]
AIP_MCP_YAHOO_TIMEOUT_SECONDS=8
AIP_MCP_YAHOO_MAX_RETRIES=1
AIP_MCP_YAHOO_RETRY_BACKOFF_SECONDS=0.2
AIP_MCP_YAHOO_MAX_CONCURRENCY=4
AIP_RESEARCH_MCP_FIRST_ENABLED=false
AIP_RESEARCH_MCP_GATEWAY_BASE_URL=http://mcp-gateway
AIP_RESEARCH_MCP_GATEWAY_TIMEOUT_SECONDS=10
AIP_RESEARCH_MCP_SERVICE_IDENTITY=research-engine
# MCP uses the AKS ServiceAccount federation and existing Key Vault CSI mount; no Azure client secret is accepted.
AIP_YAHOO_MCP_ENVIRONMENT=AZURE
AIP_YAHOO_MCP_TRANSPORT=streamable-http
AIP_YAHOO_MCP_HOST=0.0.0.0
AIP_YAHOO_MCP_PORT=8002
AIP_YAHOO_MCP_HTTP_PATH=/mcp
AIP_YAHOO_MCP_UPSTREAM_TIMEOUT_SECONDS=8
AIP_YAHOO_MCP_MAX_CONCURRENCY=4
AIP_YAHOO_MCP_ALLOWED_HOSTS=yahoo-finance-mcp,yahoo-finance-mcp:*,yahoo-finance-mcp.<namespace>.svc,yahoo-finance-mcp.<namespace>.svc:*
AIP_LLM_PROVIDER=<configured-provider>
AIP_RESEARCH_LIVE_ENABLED=false
AIP_RESEARCH_DEMO_ENABLED=false
AIP_RESEARCH_SEARCH_ENABLED=false
AIP_RESEARCH_SEARCH_PROVIDER=disabled
AIP_RESEARCH_SEARCH_ENDPOINT=
AIP_RESEARCH_SEARCH_API_KEY=
AIP_RESEARCH_SEARCH_ENGINE_ID=
AIP_RESEARCH_SEARCH_WINDOW_MONTHS=12
AIP_RESEARCH_SEARCH_MAX_QUERIES_PER_CATEGORY=6
AIP_RESEARCH_SEARCH_MAX_RESULTS_PER_QUERY=5
AIP_RESEARCH_SEARCH_MAX_DOCUMENTS_PER_REFRESH=6
AIP_RESEARCH_SEARCH_REFRESH_COOLDOWN_SECONDS=3600
AIP_STRUCTURED_PROVIDER_ENABLED=true
AIP_STRUCTURED_PROVIDER_TIMEOUT_SECONDS=10
AIP_STRUCTURED_RESOLUTION_MIN_CONFIDENCE=0.62
AIP_STRUCTURED_RESOLUTION_AMBIGUITY_MARGIN=0.08
AIP_STRUCTURED_MARKET_PRICE_FRESHNESS_SECONDS=300
AIP_STRUCTURED_FUNDAMENTALS_FRESHNESS_SECONDS=86400
AIP_RESEARCH_SEARCH_CACHE_TTL_SECONDS=86400
AIP_RESEARCH_SEARCH_ALLOWED_DOMAINS=[]
AIP_RESEARCH_PERSISTENCE_ENABLED=false
AIP_RESEARCH_DATABASE_BACKEND=postgres
AIP_RESEARCH_DATABASE_HOST=<postgresql-host>
AIP_RESEARCH_DATABASE_PORT=5432
AIP_RESEARCH_DATABASE_NAME=investment
AIP_RESEARCH_DATABASE_USER=<postgresql-user>
AIP_RESEARCH_DATABASE_PASSWORD=
AIP_RESEARCH_DATABASE_SCHEMA=research
AIP_PORTFOLIO_SERVICE_BASE_URL=http://portfolio-service

# Broker credentials and tokens must come from secure runtime configuration.
IBKR_ENABLED=false
IBKR_BASE_URL=
IBKR_OAUTH2_BASE_URL=
IBKR_GATEWAY_BASE_URL=
IBKR_CLIENT_ID=
IBKR_CLIENT_KEY_ID=
IBKR_CALLBACK_URL=
IBKR_AUTH_METHOD=
IBKR_OFFICIAL_DOCUMENTATION_VERIFIED=false
IBKR_MARKET_DATA_ENABLED=false
IBKR_INSECURE_TLS=false
IBKR_CONNECTOR_BASE_URL=http://ibkr-connector
IBKR_CONNECTOR_RUNTIME_MODE=LOCAL_AGENT
IBKR_CONNECTOR_LOGIN_URL=
IBKR_CONNECTOR_INTERNAL_TOKEN=
IBKR_CONNECTOR_IDLE_TIMEOUT_SECONDS=1800
IBKR_CONNECTOR_SESSION_TIMEOUT_SECONDS=86400
AIP_IBKR_GATEWAY_PACKAGE_PATH=
AIP_IBKR_GATEWAY_BASE_URL=
AIP_IBKR_GATEWAY_TLS_VERIFY=true
AIP_IBKR_LOGIN_PUBLIC_BASE_URL=
AIP_INTERNAL_TOKEN=
IBKR_PRIVATE_KEY_REFERENCE=
IBKR_SESSION_REFERENCE=

ICICI_DIRECT_ENABLED=false
ICICI_DIRECT_BASE_URL=
ICICI_DIRECT_LOGIN_URL=https://api.icicidirect.com/apiuser/login
ICICI_DIRECT_APP_KEY=
ICICI_DIRECT_REDIRECT_URL=
ICICI_DIRECT_AUTH_METHOD=
ICICI_DIRECT_SECRET_KEY_REFERENCE=
ICICI_DIRECT_OFFICIAL_DOCUMENTATION_VERIFIED=false

MARKET_DATA_DEMO_MODE=false
RESEARCH_ENGINE_BASE_URL=http://research-engine
# Store real values in Azure Key Vault / Kubernetes secrets, not in this file.
BROKER_ADVANCED_INDIVIDUAL_CREDENTIALS_ENABLED=false
